# Ключ Google Gemini
GEMINI_API_KEY=
# Длинная случайная строка, например: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Секрет для /api/webhook/sms (заголовок X-Webhook-Secret или ?secret=...)
SMS_WEBHOOK_SECRET=
# Необязательно: путь к soffice, если он не находится автоматически
LIBREOFFICE_PATH=
PORT=5000
