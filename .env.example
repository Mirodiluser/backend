# Ключ Google Gemini
GEMINI_API_KEY=
# Длинная случайная строка, например: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Секрет для /api/webhook/sms (заголовок X-Webhook-Secret или ?secret=...)
SMS_WEBHOOK_SECRET=
# Необязательно: путь к soffice, если он не находится автоматически
LIBREOFFICE_PATH=
PORT=5000
# Необязательно: путь к файлу базы данных (по умолчанию users.db рядом с index.js).
# На хостингах с временной файловой системой укажите путь на постоянный диск.
# DB_PATH=/data/users.db
# Необязательно: сколько секунд живёт заказ на оплату (по умолчанию 900 = 15 минут)
# ORDER_TTL_SECONDS=900
