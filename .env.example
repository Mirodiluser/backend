# Скопируйте этот файл в .env и заполните значения.

# --- Обязательно ---

# Секрет для подписи токенов входа. Длинная случайная строка, например:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Если не задан, при каждом перезапуске сервера все пользователи будут разлогинены.
JWT_SECRET=

# Общий секрет для вебхука SMS (POST /api/webhook/sms).
# Приложение на телефоне, которое пересылает SMS, должно отправлять его
# в заголовке  x-webhook-secret: <значение>   (или в адресе: /api/webhook/sms?secret=<значение>).
# Если не задан, вебхук отключён и автоматическое зачисление оплаты работать не будет.
WEBHOOK_SECRET=

# Ключ Google Gemini (проверка грамматики и транслитерация)
GEMINI_API_KEY=

# --- Необязательно ---

# Порт сервера (по умолчанию 5000)
# PORT=5000

# Путь к файлу базы данных (по умолчанию users.db рядом с index.js).
# На хостингах с временной файловой системой укажите путь на постоянный диск.
# DB_PATH=/data/users.db

# Сколько секунд живёт заказ на оплату (по умолчанию 1800 = 30 минут).
# За это время сумма закреплена за пользователем и входящий платёж будет засчитан.
# ORDER_TTL_SEC=1800
